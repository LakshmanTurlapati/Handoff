{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "out",
    "rootDir": "src",
    "tsBuildInfoFile": "./.tsbuildinfo.node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@achilles/app": ["src/shared/constants.ts"],
      "@achilles/app/main/*": ["src/main/*"],
      "@achilles/app/preload/*": ["src/preload/*"],
      "@achilles/app/renderer/*": ["src/renderer/*"],
      "@achilles/app/shared/*": ["src/shared/*"],
      "@achilles/achilles-skill": [
        "../../packages/achilles-skill/dist/index.d.ts"
      ],
      "@achilles/achilles-skill/*": [
        "../../packages/achilles-skill/dist/*.d.ts"
      ],
      "@achilles/claude-code-bridge": [
        "../../packages/claude-code-bridge/dist/index.d.ts"
      ],
      "@achilles/claude-code-bridge/*": [
        "../../packages/claude-code-bridge/dist/*.d.ts"
      ],
      "@achilles/voice-protocol": [
        "../../packages/voice-protocol/dist/index.d.ts"
      ],
      "@achilles/voice-protocol/*": [
        "../../packages/voice-protocol/dist/*.d.ts"
      ],
      "@achilles/voice-stt": [
        "../../packages/voice-stt/dist/index.d.ts"
      ],
      "@achilles/voice-stt/*": [
        "../../packages/voice-stt/dist/*.d.ts"
      ],
      "@achilles/voice-tts": [
        "../../packages/voice-tts/dist/index.d.ts"
      ],
      "@achilles/voice-tts/*": [
        "../../packages/voice-tts/dist/*.d.ts"
      ]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "test/**"
  ]
}
