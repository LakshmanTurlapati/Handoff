{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "sourceMap": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@achilles/achilles-skill": [
        "../../packages/achilles-skill/dist/index.d.ts"
      ],
      "@achilles/achilles-skill/*": [
        "../../packages/achilles-skill/dist/*.d.ts"
      ],
      "@achilles/claude-code-bridge": [
        "../../packages/claude-code-bridge/dist/index.d.ts"
      ],
      "@achilles/claude-code-bridge/*": [
        "../../packages/claude-code-bridge/dist/*.d.ts"
      ],
      "@achilles/voice-protocol": [
        "../../packages/voice-protocol/dist/index.d.ts"
      ],
      "@achilles/voice-protocol/*": [
        "../../packages/voice-protocol/dist/*.d.ts"
      ],
      "@achilles/voice-stt": [
        "../../packages/voice-stt/dist/index.d.ts"
      ],
      "@achilles/voice-stt/*": [
        "../../packages/voice-stt/dist/*.d.ts"
      ],
      "@achilles/voice-tts": [
        "../../packages/voice-tts/dist/index.d.ts"
      ],
      "@achilles/voice-tts/*": [
        "../../packages/voice-tts/dist/*.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.mjs"
  ],
  "exclude": ["dist", "node_modules"]
}
